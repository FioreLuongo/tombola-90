{
  "entities": {
    "JackpotBank": {
      "title": "JackpotBank",
      "description": "Cumulative bank for unclaimed lottery prize pools and rollover jackpots across game sessions.",
      "type": "object",
      "properties": {
        "accumulatedUnclaimed": {
          "type": "number",
          "description": "Total cumulative amount of unclaimed prizes carried over."
        },
        "currency": {
          "type": "string",
          "description": "Currency symbol (€, £, $)."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last update."
        },
        "totalGamesRecorded": {
          "type": "number",
          "description": "Total number of games that have contributed to or drawn from this bank."
        }
      },
      "required": ["accumulatedUnclaimed", "currency", "lastUpdated"]
    },
    "UnclaimedHistory": {
      "title": "UnclaimedHistory",
      "description": "Audit ledger of prize rollover deposits, recalls, and adjustments.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ledger entry ID."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the transaction."
        },
        "gameId": {
          "type": "string",
          "description": "Game identifier."
        },
        "type": {
          "type": "string",
          "enum": ["deposit_expired", "recalled_into_game", "manual_adjustment", "reset"],
          "description": "Type of transaction."
        },
        "amount": {
          "type": "number",
          "description": "Amount deposited or recalled."
        },
        "balanceAfter": {
          "type": "number",
          "description": "Cloud bank balance after transaction."
        },
        "prizeCategory": {
          "type": "string",
          "description": "Prize category that expired or was affected."
        },
        "note": {
          "type": "string",
          "description": "Human-readable description or log note."
        }
      },
      "required": ["id", "timestamp", "type", "amount", "balanceAfter"]
    },
    "RegiaProfile": {
      "title": "RegiaProfile",
      "description": "Saved difficulty and prize expiration threshold profile for Regia game control.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique profile identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Human-readable profile name."
        },
        "isPreset": {
          "type": "boolean",
          "description": "Whether this profile is one of the built-in presets."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether mathematical anti-win control is enabled."
        },
        "difficultyLevel": {
          "type": "string",
          "enum": ["high", "medium", "normal", "random", "custom"],
          "description": "Difficulty algorithm strategy."
        },
        "forcedMinAmbo": { "type": "number" },
        "forcedMinTerno": { "type": "number" },
        "forcedMinQuaterna": { "type": "number" },
        "forcedMinCinquina": { "type": "number" },
        "forcedMinTombola": { "type": "number" },
        "delayMaxGold": { "type": "number" },
        "delayMaxAmbo": { "type": "number" },
        "delayMaxTerno": { "type": "number" },
        "delayMaxQuaterna": { "type": "number" },
        "delayMaxCinquina": { "type": "number" },
        "delayMaxTombola": { "type": "number" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp of last save."
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "difficultyLevel",
        "forcedMinAmbo",
        "forcedMinTerno",
        "forcedMinQuaterna",
        "forcedMinCinquina",
        "forcedMinTombola",
        "delayMaxGold",
        "delayMaxAmbo",
        "delayMaxTerno",
        "delayMaxQuaterna",
        "delayMaxCinquina",
        "delayMaxTombola",
        "updatedAt"
      ]
    },
    "ActiveRegiaSettings": {
      "title": "ActiveRegiaSettings",
      "description": "Pointer and snapshot of the currently active Regia difficulty & threshold profile.",
      "type": "object",
      "properties": {
        "activeProfileId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["activeProfileId", "updatedAt"]
    }
  },
  "firestore": {
    "/jackpot_bank/{bankId}": {
      "schema": "JackpotBank",
      "description": "Singleton or game category jackpot bank totals."
    },
    "/unclaimed_history/{historyId}": {
      "schema": "UnclaimedHistory",
      "description": "Detailed history of unclaimed prize rollover transactions."
    },
    "/regia_profiles/{profileId}": {
      "schema": "RegiaProfile",
      "description": "Saved difficulty and prize threshold profiles managed manually in Regia."
    },
    "/regia_settings/{settingId}": {
      "schema": "ActiveRegiaSettings",
      "description": "Active Regia configuration pointing to the selected profile."
    }
  }
}
