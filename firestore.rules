rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidThreshold(n, minVal, maxVal) {
      return (n is int || n is float) && n >= minVal && n <= maxVal;
    }

    function isValidRegiaProfile(data) {
      return data.keys().hasAll([
               'id', 'name', 'enabled', 'difficultyLevel',
               'forcedMinAmbo', 'forcedMinTerno', 'forcedMinQuaterna', 'forcedMinCinquina', 'forcedMinTombola',
               'delayMaxGold', 'delayMaxAmbo', 'delayMaxTerno', 'delayMaxQuaterna', 'delayMaxCinquina', 'delayMaxTombola',
               'updatedAt'
             ])
             && data.keys().hasOnly([
               'id', 'name', 'isPreset', 'enabled', 'difficultyLevel',
               'forcedMinAmbo', 'forcedMinTerno', 'forcedMinQuaterna', 'forcedMinCinquina', 'forcedMinTombola',
               'delayMaxGold', 'delayMaxAmbo', 'delayMaxTerno', 'delayMaxQuaterna', 'delayMaxCinquina', 'delayMaxTombola',
               'updatedAt'
             ])
             && isValidId(data.id)
             && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
             && (!('isPreset' in data) || data.isPreset is bool)
             && data.enabled is bool
             && data.difficultyLevel in ['high', 'medium', 'normal', 'random', 'custom']
             && isValidThreshold(data.forcedMinAmbo, 1, 90)
             && isValidThreshold(data.forcedMinTerno, 1, 90)
             && isValidThreshold(data.forcedMinQuaterna, 1, 90)
             && isValidThreshold(data.forcedMinCinquina, 1, 90)
             && isValidThreshold(data.forcedMinTombola, 1, 90)
             && isValidThreshold(data.delayMaxGold, 5, 90)
             && isValidThreshold(data.delayMaxAmbo, 5, 90)
             && isValidThreshold(data.delayMaxTerno, 5, 90)
             && isValidThreshold(data.delayMaxQuaterna, 5, 90)
             && isValidThreshold(data.delayMaxCinquina, 5, 90)
             && isValidThreshold(data.delayMaxTombola, 5, 90)
             && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidActiveRegiaSettings(data) {
      return data.keys().hasAll(['activeProfileId', 'updatedAt'])
             && data.keys().hasOnly(['activeProfileId', 'updatedAt'])
             && isValidId(data.activeProfileId)
             && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidRegiaGameConfig(data) {
      return data.keys().hasAll(['id', 'activeProfileId', 'difficulty', 'thresholds', 'prizes', 'updatedAt'])
             && data.keys().hasOnly(['id', 'activeProfileId', 'difficulty', 'thresholds', 'prizes', 'updatedAt'])
             && isValidId(data.id)
             && isValidId(data.activeProfileId)
             && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40
             && data.difficulty is map
             && data.difficulty.keys().hasAll(['enabled', 'level', 'forcedMinAmbo', 'forcedMinTerno', 'forcedMinQuaterna', 'forcedMinCinquina', 'forcedMinTombola'])
             && data.difficulty.keys().hasOnly(['enabled', 'level', 'forcedMinAmbo', 'forcedMinTerno', 'forcedMinQuaterna', 'forcedMinCinquina', 'forcedMinTombola'])
             && data.difficulty.enabled is bool
             && data.difficulty.level in ['high', 'medium', 'normal', 'random', 'custom']
             && isValidThreshold(data.difficulty.forcedMinAmbo, 1, 90)
             && isValidThreshold(data.difficulty.forcedMinTerno, 1, 90)
             && isValidThreshold(data.difficulty.forcedMinQuaterna, 1, 90)
             && isValidThreshold(data.difficulty.forcedMinCinquina, 1, 90)
             && isValidThreshold(data.difficulty.forcedMinTombola, 1, 90)
             && data.thresholds is map
             && data.thresholds.keys().hasAll(['delayMaxGold', 'delayMaxAmbo', 'delayMaxTerno', 'delayMaxQuaterna', 'delayMaxCinquina', 'delayMaxTombola'])
             && data.thresholds.keys().hasOnly(['delayMaxGold', 'delayMaxAmbo', 'delayMaxTerno', 'delayMaxQuaterna', 'delayMaxCinquina', 'delayMaxTombola'])
             && isValidThreshold(data.thresholds.delayMaxGold, 5, 90)
             && isValidThreshold(data.thresholds.delayMaxAmbo, 5, 90)
             && isValidThreshold(data.thresholds.delayMaxTerno, 5, 90)
             && isValidThreshold(data.thresholds.delayMaxQuaterna, 5, 90)
             && isValidThreshold(data.thresholds.delayMaxCinquina, 5, 90)
             && isValidThreshold(data.thresholds.delayMaxTombola, 5, 90)
             && data.prizes is map
             && data.prizes.keys().hasAll(['prizePool', 'currency'])
             && data.prizes.keys().hasOnly(['prizePool', 'currency'])
             && (data.prizes.prizePool is int || data.prizes.prizePool is float)
              && data.prizes.prizePool >= 0 && data.prizes.prizePool <= 100000000
              && data.prizes.currency is string && data.prizes.currency.size() >= 1 && data.prizes.currency.size() <= 8;
    }

    function isValidTavoloSetMeta(data) {
      return data.keys().hasAll(['id', 'gameId', 'name', 'totalSheets', 'activeSheets', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['id', 'gameId', 'name', 'totalSheets', 'activeSheets', 'createdAt', 'updatedAt'])
             && isValidId(data.id)
             && isValidId(data.gameId)
             && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
             && data.totalSheets is int && data.totalSheets >= 1 && data.totalSheets <= 100
             && data.activeSheets is list && data.activeSheets.size() <= 100
             && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 40
             && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidTavoloSheetDoc(data, setId) {
      return data.keys().hasAll(['id', 'setId', 'gameId', 'sheetNumber', 'sheetLabel', 'cards', 'updatedAt'])
             && data.keys().hasOnly(['id', 'setId', 'gameId', 'sheetNumber', 'sheetLabel', 'cards', 'updatedAt'])
             && isValidId(data.id)
             && isValidId(data.setId) && data.setId == setId
             && isValidId(data.gameId)
             && data.sheetNumber is int && data.sheetNumber >= 1 && data.sheetNumber <= 100
             && data.sheetLabel is string && data.sheetLabel.size() >= 1 && data.sheetLabel.size() <= 10
             && data.cards is list && data.cards.size() == 24
             && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    // Test connection document
    match /test/connection {
      allow read, write: if true;
    }

    // Cumulative jackpot bank + active game unclaimed prizes
    match /jackpot_bank/{bankId} {
      allow read: if isValidId(bankId);
      allow write: if isValidId(bankId)
                   && request.resource.data.accumulatedUnclaimed is number
                   && request.resource.data.accumulatedUnclaimed >= 0
                   && (!('currentGameUnclaimed' in request.resource.data)
                       || (request.resource.data.currentGameUnclaimed is number
                           && request.resource.data.currentGameUnclaimed >= 0))
                   && request.resource.data.currency is string
                   && request.resource.data.currency.size() <= 8;
    }

    // Ledger of prize deposits, recalls, and game sessions
    match /unclaimed_history/{historyId} {
      allow read: if true;
      allow create: if isValidId(historyId)
                    && request.resource.data.amount is number
                    && request.resource.data.balanceAfter is number
                    && request.resource.data.type in ['deposit_expired', 'recalled_into_game', 'manual_adjustment', 'reset'];
      allow update, delete: if false;
    }

    // Saved Regia difficulty & prize threshold profiles
    match /regia_profiles/{profileId} {
      allow read: if true;
      allow create, update: if isValidId(profileId)
                            && isValidRegiaProfile(request.resource.data)
                            && request.resource.data.id == profileId;
      allow delete: if isValidId(profileId);
    }

    // Active Regia profile pointer
    match /regia_settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isValidActiveRegiaSettings(request.resource.data);
      allow delete: if false;
    }

    // Unified single-document Regia live game configuration (difficulty, thresholds, prizes)
    match /regia_config/{configId} {
      allow read: if isValidId(configId);
      allow create, update: if isValidId(configId)
                            && isValidRegiaGameConfig(request.resource.data)
                            && request.resource.data.id == configId;
      allow delete: if false;
    }

    // Permanent table game card sets (e.g. TAV-G001) and active sheet selection
    match /tavolo_sets/{setId} {
      allow read: if true;
      allow create, update: if isValidId(setId)
                            && isValidTavoloSetMeta(request.resource.data)
                            && request.resource.data.id == setId
                            && request.resource.data.gameId == setId;
      allow delete: if false;

      match /sheets/{sheetId} {
        allow read: if true;
        allow create, update: if isValidId(setId) && isValidId(sheetId)
                              && exists(/databases/$(database)/documents/tavolo_sets/$(setId))
                              && isValidTavoloSheetDoc(request.resource.data, setId)
                              && request.resource.data.id == sheetId;
        allow delete: if false;
      }
    }
  }
}
